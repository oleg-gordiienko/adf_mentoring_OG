{
	"name": "FromPremSQLToAzureSQL",
	"properties": {
		"activities": [
			{
				"name": "TicketCopy",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "LastExtractLookup",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "@concat(\n    'select * from [dbo].[Tickets] where [TransactionDt] > CONVERT(DATETIME, ''',\n     activity('LastExtractLookup').output.firstRow.last_extract,\n     ''')'\n)\n",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"isolationLevel": "ReadCommitted",
						"partitionOption": "None"
					},
					"sink": {
						"type": "AzureSqlSink",
						"preCopyScript": "truncate table [stg].[cinema_tickets]",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false,
						"disableMetricsCollection": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "CinemaCode",
									"type": "String",
									"physicalType": "nvarchar"
								},
								"sink": {
									"name": "cinema_code",
									"type": "String",
									"physicalType": "nvarchar"
								}
							},
							{
								"source": {
									"name": "CinemaName",
									"type": "String",
									"physicalType": "nvarchar"
								},
								"sink": {
									"name": "cinema_name",
									"type": "String",
									"physicalType": "nvarchar"
								}
							},
							{
								"source": {
									"name": "MovieId",
									"type": "Int32",
									"physicalType": "int"
								},
								"sink": {
									"name": "movie_id",
									"type": "Int32",
									"physicalType": "int"
								}
							},
							{
								"source": {
									"name": "TicketCount",
									"type": "Int32",
									"physicalType": "int"
								},
								"sink": {
									"name": "ticket_count",
									"type": "Int32",
									"physicalType": "int"
								}
							},
							{
								"source": {
									"name": "TicketPrice",
									"type": "Decimal",
									"physicalType": "decimal",
									"scale": 1,
									"precision": 4
								},
								"sink": {
									"name": "ticket_price",
									"type": "Decimal",
									"physicalType": "decimal",
									"scale": 1,
									"precision": 4
								}
							},
							{
								"source": {
									"name": "TransactionId",
									"type": "String",
									"physicalType": "nvarchar"
								},
								"sink": {
									"name": "transaction_id",
									"type": "String",
									"physicalType": "nvarchar"
								}
							},
							{
								"source": {
									"name": "TransactionDt",
									"type": "DateTime",
									"physicalType": "datetime"
								},
								"sink": {
									"name": "transaction_date",
									"type": "DateTime",
									"physicalType": "datetime"
								}
							}
						],
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "OnPremSQL",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "SinkAzureSQLTickets",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "LastExtractLookup",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "select last_extract \nfrom extract_log \nwhere table_name = 'tCinemaTickets'",
						"queryTimeout": "02:00:00",
						"isolationLevel": "ReadCommitted",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSQLExtractLog",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "UpdateExtractLog",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "InsertNewTickets",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "SinkSqlDatabase1",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "UPDATE [dbo].[extract_log]\n   SET [last_extract] = (select max(transaction_date) from stg.cinema_tickets)\nWHERE [table_name] = 'tCinemaTickets'\nAND 0 < (select count(*) from stg.cinema_tickets)"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "RefreshCinemas",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "TicketCopy",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "SinkSqlDatabase1",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "with main as (select distinct cinema_code, cinema_name from [stg].[cinema_tickets]) \nupdate [dbo].[tCinema]\nset CinemaName = (select cinema_name from main where CinemaCode = cinema_code)\n, ModifiedDate = SYSDATETIME()\nwhere CinemaCode in (select cinema_code from main)\n"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "InsertNewCinemas",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "RefreshCinemas",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "SinkSqlDatabase1",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "insert into [dbo].[tCinema] (CinemaCode, CinemaName, CreatedDate, ModifiedDate)\nselect m.cinema_code, m.cinema_name, SYSDATETIME(),SYSDATETIME() \nfrom \n\t(select distinct t.cinema_code, t.cinema_name \n\tfrom [stg].[cinema_tickets] t \n\twhere t.cinema_code not in \n\t\t(select CinemaCode from [dbo].[tCinema])\n\t) m"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "InsertNewTickets",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "InsertNewCinemas",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "SinkSqlDatabase1",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "insert into tCinemaTickets (\r\n    MovieId, \r\n    CinemaId, \r\n    TicketCount, TicketPrice, TransactionId, TransactionDate, CreatedDate)\r\nselect \r\n    (select MovieId from tMovies where MovieIdNK = t.movie_id) MovieId,\r\n    (select CinemaId from [tCinema] where CinemaCode = t.cinema_code) CinemaId, \r\n    t.ticket_count, t.ticket_price, t.transaction_id, t.transaction_date, SYSDATETIME() \r\nfrom [stg].[cinema_tickets] t\r\n\r\n"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-02-26T10:35:08Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}